<$list filter="[[$:/plugins/tiddlywiki/freelinks]is[tiddler]]" variable="ignore">

/* ==========================================================================
** Freelinks
**
** The plugin's whole stylesheet is one rule: a #5777d91c wash behind any word
** that happens to match a tiddler title. That is a fixed blue at 11% alpha, so
** on a dark palette it is invisible and on a cream one it is a faintly bruised
** patch behind ordinary prose.
**
** A freelink is not the same thing as a link the author typed - it is the wiki
** noticing a word. So the theme marks it the way a reader marks a word they
** might look up later: a dotted underline in the link colour, no fill, nothing
** behind the text. It stays out of the way while reading and becomes a proper
** link on hover.
** ========================================================================== */

button.tc-tiddlylink.tc-freelink,
a.tc-tiddlylink.tc-freelink {
	background-color: transparent;
	text-decoration: underline;
	text-decoration-style: dotted;
	text-decoration-thickness: 1px;
	text-underline-offset: 0.18em;
	text-decoration-color: color-mix(in oklch, var(--tpc-tiddler-link-foreground) 55%, transparent);
	transition: text-decoration-color 140ms var(--btc-ease-out), background-color 140ms var(--btc-ease-out);
}

button.tc-tiddlylink.tc-freelink:hover,
a.tc-tiddlylink.tc-freelink:hover {
	background-color: color-mix(in oklch, var(--tpc-primary) 12%, transparent);
	text-decoration-style: solid;
	text-decoration-color: var(--tpc-tiddler-link-foreground);
	border-radius: 2px;
}

</$list>
