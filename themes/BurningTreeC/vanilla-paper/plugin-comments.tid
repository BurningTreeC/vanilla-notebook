<$list filter="[[$:/plugins/tiddlywiki/comments]is[tiddler]]" variable="ignore">

/* ==========================================================================
** Comments
**
** A comment thread is a margin note that grew up, so Paper sets it as one:
** no boxes, no 2px borders, just an indent rule down the side of each reply
** the way a nested quotation is marked in a printed book. The plugin's own
** treatment - 2px solid borders and rounded rectangles around every entry -
** turns a conversation into a stack of cards, which fights the page.
**
** Nesting is what a comment thread is FOR, and the indent rule shows it for
** free at any depth, where a border only tells you there is a box.
** ========================================================================== */

.tc-comments-segment {
	margin-block-start: var(--vp-space-lg);
	padding-block-start: var(--vp-space-md);
	border-block-start: 1px solid var(--vp-rule);
}

.tc-is-comment-header {
	padding: 0;
	border: none;
	border-radius: 0;
	background: none;
	font-family: var(--vp-font-ui);
	font-size: 0.8125rem;
	font-weight: 600;
	letter-spacing: 0.04em;
	text-transform: uppercase;
	color: var(--vp-ink-faint);
}

.tc-comment-list {
	list-style: none;
	padding-inline-start: 0;
}

/* The indent rule. Each level of reply gets one hairline down its inline
   start, so depth is legible without a box. */
.tc-comment-list .tc-comments {
	padding-inline-start: var(--vp-space-md);
	border-inline-start: 1px solid var(--vp-rule-faint);
}

.tc-comment-entry {
	position: relative;
	margin-block: var(--vp-space-sm) 0;
	padding-inline-start: var(--vp-space-sm);
	border: none;
	border-radius: 0;
	border-inline-start: 2px solid var(--vp-rule);
	background: none;
	transition: border-color 140ms var(--vp-ease-out);
}

.tc-comment-entry:hover {
	border-inline-start-color: var(--vp-accent-edge);
}

/* Who and when: apparatus, so the interface face and a muted ink. The plugin
   sets this on the message surface, which reads as a highlighted banner. */
.tc-comment-entry-heading {
	padding: 0;
	background: none;
	color: var(--vp-ink-faint);
	font-family: var(--vp-font-ui);
	font-size: 0.6875rem;
	font-weight: 600;
	letter-spacing: 0.04em;
	text-transform: uppercase;
}

/* The comment itself is prose, so it is set in the body face rather than
   shrunk to 0.8em of whatever the surrounding element happened to be. */
.tc-comment-entry-body {
	padding: 0;
	font-family: var(--vp-font-body);
	font-size: 0.9375rem;
	line-height: 1.55;
}

.tc-comment-entry-body textarea {
	inline-size: 100%;
	font-family: var(--vp-font-code);
	font-size: 0.9375rem;
	background-color: var(--tpc-tiddler-editor-background);
	border: 1px solid var(--tpc-tiddler-editor-border);
	border-radius: var(--vp-radius);
}

/* The plugin fills the add-comment icon with `download-background`, a colour
   that has nothing to do with commenting and is a saturated green in most
   palettes. */
.tc-comment-button button svg {
	fill: var(--tpc-tiddler-controls-foreground);
	block-size: 1.5em;
	inline-size: 1.5em;
	transition: fill 140ms var(--vp-ease-out);
}

.tc-comment-button button:hover svg {
	fill: var(--tpc-primary);
}

.tc-comment-button button {
	inline-size: 100%;
	text-align: end;
}

.tc-sidebar-scrollable .tc-comment-button button {
	inline-size: auto;
}

</$list>
