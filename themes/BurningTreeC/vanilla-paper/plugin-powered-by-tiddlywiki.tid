/* ==========================================================================
** Powered by TiddlyWiki
**
** A badge pinned to the bottom corner of the window at z-index 2000. The
** plugin gives it `right: 1em`, which is physical - in a right-to-left wiki it
** stays on the right, on top of the sidebar, instead of moving to the other
** corner with everything else. Logical properties put it on the trailing edge
** in both directions.
**
** It also sits above the story river with no offset, so on a narrow screen it
** covers the last line of whatever you are reading. A small opacity at rest
** keeps it out of the way, full opacity on hover keeps it usable.
** ========================================================================== */

.tc-powered-by-tiddlywiki-banner {
	position: fixed;
	inset-inline-end: var(--vp-space-md);
	inset-block-end: 0;
	z-index: 2000;
	opacity: 0.55;
	transition: opacity 160ms var(--vp-ease-out);
}

.tc-powered-by-tiddlywiki-banner:hover,
.tc-powered-by-tiddlywiki-banner:focus-within {
	opacity: 1;
}

</$list>
