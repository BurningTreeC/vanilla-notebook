title: $:/themes/BurningTreeC/vanilla-paper/1-layout
tags: [[$:/tags/Stylesheet]]
list-before:
code-body: yes

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/* Hallmark · macrostructure: n/a (application chrome, not a page) · tone: editorial · anchor hue: warm-neutral
 * theme: the theme · genre: editorial
 * pre-emit critique: P5 H5 E5 S5 R4 V5
 *
 * ============================================================================
 * ENAMEL — LAYOUT ENGINE
 * ============================================================================
 *
 * The problem this file solves
 * ----------------------------
 * Vanilla changes the sidebar/story layout by SWAPPING CSS RULES. The macros
 * `if-no-sidebar` and `if-fluid-fixed` (core/wiki/macros/CSS.tid) wrap CSS text
 * in a reveal widget, so toggling $:/state/sidebar rewrites the stylesheet
 * A stylesheet edit is applied in a single frame — there is no start value to
 * interpolate from, so the layout JUMPS.
 *
 * How the theme does it instead
 * ----------------------------
 * Every rule below is emitted UNCONDITIONALLY. Nothing is wrapped in a reveal.
 * State arrives as a class on .tc-page-container, contributed by
 * $:/themes/BurningTreeC/vanilla-paper/classfilter through the core's
 * $:/tags/ClassFilters/PageTemplate hook:
 *
 *     btc-sidebar-open | btc-sidebar-closed
 *     btc-layout-fluid-fixed | btc-layout-fixed-fluid
 *
 * Those classes set ONE registered custom property, `--btc-open` (1 = open,
 * 0 = closed). Because it is registered via @property with an actual
 * `<number>` syntax, the browser can INTERPOLATE it, and a single transition
 * on the page container drives every derived measurement at once. One scalar,
 * one transition, both layouts, both text directions.
 *
 * What is actually GPU-accelerated — an honest accounting
 * ------------------------------------------------------
 * A reflow cannot be composited. Where the story river genuinely has to change
 * width, that is layout work by definition, and no amount of `translate3d`
 * changes it. So:
 *
 *   fixed-fluid  the river's width is FIXED. Nothing reflows. The sidebar
 *                slides on `translate` and the river glides to centre on
 *                `translate`. Both are compositor-only. Fully GPU.
 *
 *   fluid-fixed  the river is fluid and MUST reclaim the freed space, so its
 *                `margin-inline-end` is interpolated. That is layout each
 *                frame — smooth and jump-free, but not GPU. Cost is bounded
 *                with `content-visibility` on off-screen tiddlers.
 *
 * In both cases the per-frame work is style recalc on one custom property plus
 * a composited transform; in fluid-fixed, plus one margin relayout.
 *
 * Direction handling
 * ------------------
 * Box geometry uses logical properties (inset-inline, margin-inline), so RTL
 * is correct for free. The one thing that is NOT direction-aware is the
 * `translate` property — its percentages are physical. `--btc-dir` (+1 for ltr,
 * -1 for rtl) flips the sign, so the sidebar always leaves toward the inline
 * end whichever way that points.
 * ============================================================================
 */

/*
** The animated scalar. Registering it is what makes the whole thing work:
** an unregistered custom property has no type, so it can only flip
** discretely — which is exactly the jump we are removing.
*/

@property --btc-open {
	syntax: "<number>";
	inherits: true;
	initial-value: 1;
}

:root {

	/* Direction multiplier for the physical `translate` axis */
	--btc-dir: 1;

	/* Metrics, lifted from the theme's metrics tiddlers */
	--btc-sidebar-w: {{{ [{$:/theme}addsuffix[/metrics/sidebarwidth]get[text]] }}};
	--btc-story-w: {{{ [{$:/theme}addsuffix[/metrics/storywidth]get[text]] }}};
	--btc-story-left: {{{ [{$:/theme}addsuffix[/metrics/storyleft]get[text]] }}};

	/*
	** The story's top offset is composed of two independent parts:
	**   --btc-story-top-base  what the user asked for in the metrics
	**   --btc-menubar-h       what a pinned menubar takes, if one is present
	** --btc-story-top is their sum. Keeping them separate is what lets a
	** non-zero storytop survive the menubar detection below.
	**
	** Only ONE of the two applies to the sidebar. `storytop` is a story river
	** metric - that is what it is named and what the core's own hint for it
	** says - so it moves the river and nothing else. Vanilla also hangs the
	** sidebar off it (its base.tid:1046), which couples two things a reader
	** would not expect to be coupled: you cannot indent the river from the top
	** of the page without the sidebar dropping with it.
	**
	** The menubar height is different in kind. A pinned bar covers the top of
	** the VIEWPORT, so anything else pinned to the viewport has to start below
	** it or slide underneath. The sidebar is fixed, so it takes that offset and
	** only that one.
	*/
	--btc-story-top-base: {{{ [{$:/theme}addsuffix[/metrics/storytop]get[text]] }}};
	--btc-menubar-h: 0px;
	--btc-story-top: var(--btc-story-top-base);
	--btc-story-right: {{{ [{$:/theme}addsuffix[/metrics/storyright]get[text]] }}};
	--btc-tiddler-w: {{{ [{$:/theme}addsuffix[/metrics/tiddlerwidth]get[text]] }}};
	--btc-gutter: {{{ [{$:/theme}addsuffix[/metrics/storygutter]get[text]] }}};

	/* Motion — tied to the user's own TiddlyWiki animation setting */
	--btc-dur: {{$:/config/AnimationDuration}}ms;
	--btc-ease: cubic-bezier(0.32, 0.72, 0, 1);
	--btc-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
}

html[dir="rtl"] {
	--btc-dir: -1;
}

/*
** --btc-side: which inline edge the sidebar is anchored to. +1 for the end
** (the default), -1 for the start.
**
** Deliberately NOT folded into --btc-dir. The two answer different questions -
** which way is forward in this script, and which edge does the panel live on -
** and only the sidebar's own slide needs both at once. The story river's glide
** needs the direction but not the side, because the side is already accounted
** for by where its margin puts it. Combining them into one number sent the
** river the wrong way in fixed-fluid with a start-side sidebar, and it ended
** up underneath the panel.
*/
:root {
	--btc-side: 1;
}

.tc-page-container.btc-sidebar-start {
	--btc-side: -1;
}

/* Prefer the real selector where it exists — it also catches dir set on a
   subtree rather than on <html>. */
@supports selector(:dir(rtl)) {
	:root:dir(rtl) {
		--btc-dir: -1;
	}
}

/*
** The state machine. Two classes, one scalar, one transition.
*/

.tc-page-container {
	--btc-open: 1;
	transition: --btc-open var(--btc-dur) var(--btc-ease);
}

/*
** Menubar plugin support.
**
** The plugin renders a `position: fixed` bar at the top of the page and
** reserves no room for it, so without this the sidebar header and the first
** tiddler slide underneath it. The plugin's own answer is to tell the user to
** set the storytop metric by hand.
**
** The height is MEASURED, not guessed. $:/themes/BurningTreeC/vanilla-paper/trackers/
** menubar asks the dimension tracker to watch `nav.tc-menubar` and publish its
** geometry to $:/info/browser/menubar; the height field is read straight into
** the variable below. An earlier version detected the bar with :has() and
** assumed 2em, which measured 30px against a real 31px bar and left a 1px
** sliver of title behind it — CSS can tell you an element exists but not how
** tall it is.
**
** `else[0]` matters: with no tracker installed, or before the first
** measurement lands, the transclusion is empty and `--btc-menubar-h: px` would
** be invalid at computed-value time, taking --btc-story-top down with it.
**
** The bar's height is ADDED to the configured storytop rather than replacing
** it. Overwriting --btc-story-top directly would silently discard a storytop
** the user had set — the two are independent reasons to push the story down
** and both have to apply at once.
**
** The sum is recomputed here on .tc-page-container, not on :root, and that
** placement is load-bearing: a custom property's var() references are resolved
** on the element where the property is DECLARED. A calc() sitting on :root
** would bake in the :root value of --btc-menubar-h and inherit that result
** downward, so a later override would never reach it.
*/
.tc-page-container {
	--btc-menubar-h: 0px;
	--btc-story-top: calc(var(--btc-story-top-base) + var(--btc-menubar-h));
}

/*
** Two questions, two mechanisms, and both are needed.
**
**   :has()   is there a menubar in THIS document?
**   tracker  how tall is it?
**
** The tracker alone is not enough, because one stylesheet serves more than one
** document. $:/core/modules/startup/windows.js renders this very sheet into
** every window opened with tm-open-window, and that window's template also
** emits a .tc-page-container (core/templates/single.tiddler.window.tid) — but
** it has no menubar. Applying the measured height unconditionally would offset
** sticky titles in those windows by the height of a bar that is not there.
**
** :has() alone is not enough either — that was the earlier version, and it had
** to guess 2em against a real 31.41px bar.
**
** Gating the measured value behind :has() gives a per-document answer with a
** measured magnitude, and degrades to 0 in any document without a bar.
**
** The measurement is read per WINDOW. The tracker keys its info tiddlers by
** window the same way $:/core/modules/info/windowdimensions.js does —
** `system/main` for the main window, `user/<windowID>` for one opened with
** tm-open-window — and windows.js hands each window's stylesheet a
** tv-window-id variable, so the filter below picks the row belonging to the
** document it is being rendered into. `~[[0]]` covers both a missing tracker
** and the frames before the first measurement lands; without it the
** declaration would be `--btc-menubar-h: px`, invalid at computed-value time,
** which would take --btc-story-top down with it.
*/
.tc-page-container:has(nav.tc-menubar) {
	--btc-menubar-h: {{{ [<tv-window-id>!is[blank]addprefix[user/]] ~[[system/main]] +[addprefix[$:/info/browser/menubar/]get[height]] ~[[0]] +[addsuffix[px]] }}};
}

.tc-page-container.btc-sidebar-closed {
	--btc-open: 0;
}

/*
** Sidebar — slides out along the inline axis on a composited transform.
**
** `visibility` is stepped (0s duration, delayed until the slide finishes on
** the way out, immediate on the way in) so a hidden sidebar leaves the tab
** order instead of staying focusable off-screen. Doing this in CSS rather
** than with an `inert` attribute keeps the markup override minimal.
*/

.tc-sidebar-scrollable {
	translate: calc(var(--btc-dir) * var(--btc-side) * (1 - var(--btc-open)) * 100%) 0;
	will-change: translate;
	overscroll-behavior: contain;
	scrollbar-gutter: stable;

	/*
	** The `transition` shorthand is declared HERE and nowhere else.
	**
	** Putting it in the state rules instead would be a trap: those rules are
	** `.btc-sidebar-open .tc-sidebar-scrollable` (specificity 0,2,0), which
	** outranks anything the mobile media block can say with a single class
	** (0,1,0) — so a compound transition set on the state rule silently wins
	** and the mobile collapse stops animating. Keeping the shorthand on the
	** single-class rule lets the media block extend it, and lets the state
	** rules vary only the delay through a custom property.
	*/
	--btc-vis-delay: 0s;
	transition: visibility 0s linear var(--btc-vis-delay);
}

.btc-sidebar-open .tc-sidebar-scrollable {
	visibility: visible;
	--btc-vis-delay: 0s;
}

/* Hidden only after the slide has finished, so it leaves the tab order
   without the panel vanishing mid-transition. */
.btc-sidebar-closed .tc-sidebar-scrollable {
	visibility: hidden;
	--btc-vis-delay: var(--btc-dur);
}

/* ==========================================================================
** Desktop — at and above the sidebar breakpoint
** ========================================================================== */

@media (min-width: {{{ [{$:/theme}addsuffix[/metrics/sidebarbreakpoint]get[text]] }}}) {

	/* --btc-menubar-h, NOT --btc-story-top: the bar has to be cleared, the
	   river's own top offset is none of the sidebar's business. */
	.tc-sidebar-scrollable {
		position: fixed;
		inset-block: var(--btc-menubar-h) 0;
		overflow-y: auto;
		overflow-x: hidden;
		-webkit-overflow-scrolling: touch;
	}

	.tc-story-river {
		position: relative;
		inset-block-start: var(--btc-story-top);
		padding: var(--btc-gutter);
	}

	/* ---- fluid-fixed: fixed-width sidebar, fluid river ------------------- */

	.btc-layout-fluid-fixed .tc-sidebar-scrollable {
		inset-inline-end: 0;
		inline-size: var(--btc-sidebar-w);
	}

	/* The river is fluid, so it genuinely reflows. Interpolating the margin
	   is what makes that a glide rather than a jump. */
	.btc-layout-fluid-fixed .tc-story-river {
		inline-size: auto;
		margin-inline: var(--btc-story-left) calc(var(--btc-open) * var(--btc-sidebar-w));
	}

	.btc-layout-fluid-fixed .tc-tiddler-frame {
		inline-size: 100%;
		max-inline-size: var(--btc-tiddler-w);
		margin-inline: auto;
	}

	/* ---- fixed-fluid: fixed-width river, fluid sidebar ------------------- */

	.btc-layout-fixed-fluid .tc-sidebar-scrollable {
		inset-inline: var(--btc-story-right) 0;
		inline-size: auto;
	}

	/*
	** Nothing here reflows. The river keeps its width and simply glides to the
	** centre of the viewport as the sidebar leaves — a composited transform,
	** so this layout is GPU-only end to end.
	**
	** The offset is "where the centre of the viewport is" minus "where the
	** river already starts", scaled by how closed the sidebar is.
	*/
	.btc-layout-fixed-fluid .tc-story-river {
		/* Where the river's leading edge sits. Named, because the glide below
		   is measured from it and the two must not drift apart. */
		--btc-river-start: var(--btc-story-left);

		inline-size: var(--btc-story-w);
		margin-inline: var(--btc-river-start) 0;
		translate: calc(
			var(--btc-dir) * (1 - var(--btc-open)) *
			((100vw - var(--btc-story-w)) / 2 - var(--btc-river-start))
		) 0;
		will-change: translate;
	}

	/*
	** The same cap as fluid-fixed above, and for the same reason: tiddlerwidth
	** is what the user asked a tiddler to be, and the mode they happen to be in
	** is no reason to ignore it. This rule used to be `inline-size: 100%` alone,
	** which silently made the setting dead in fixed-fluid — ThemeTweaks still
	** offered the field, editing it did nothing, and every tiddler was as wide
	** as the river whatever the number said.
	**
	** The pair reads as one behaviour: grow with the river up to tiddlerwidth,
	** then stop; shrink with it below that. `inline-size: 100%` is measured
	** against the river's CONTENT box, so the gutter is already subtracted and
	** a frame can never overhang the river however narrow it gets. Which is
	** also why the defaults look unchanged: storywidth 800 less two 40px
	** gutters is exactly the 720 tiddlerwidth ships with, so the cap only
	** starts to bite once someone moves one of them.
	**
	** This is what the resizer leans on. sidebar.tid drags storywidth and
	** storyright and deliberately leaves tiddlerwidth alone; widening the
	** river then widens the river and not the tiddlers, and narrowing it past
	** the cap takes the tiddlers down with it — without a drag ever writing to
	** the metric, so a width the user chose survives being dragged over.
	**
	** margin-inline: auto centres what the cap leaves over. Without it a capped
	** frame sits against the river's leading edge and the slack all collects on
	** one side.
	*/
	.btc-layout-fixed-fluid .tc-tiddler-frame {
		inline-size: 100%;
		max-inline-size: var(--btc-tiddler-w);
		margin-inline: auto;
	}

	/* ---- Full-width option ----------------------------------------------
	**
	** The river takes every pixel the sidebar is not currently using. The
	** arithmetic is per-layout, because what the sidebar occupies differs —
	** and, importantly, the sidebar keeps the sizing behaviour its layout mode
	** promises. Full width is about the RIVER; it does not repossess the
	** sidebar.
	**
	**   fluid-fixed  the sidebar is a fixed --btc-sidebar-w column, so the
	**                river takes the viewport minus that, and grows by that
	**                same amount as the sidebar leaves.
	**
	**   fixed-fluid  the sidebar is FLUID and legitimately owns everything
	**                past --btc-story-right for as long as it is visible. So
	**                while it is open the river stays at its normal width and
	**                full width changes nothing but the tiddler cap — that is
	**                correct, not a no-op bug. Once the sidebar is hidden,
	**                that whole region frees up and the river takes the lot,
	**                instead of keeping its fixed width and gliding to centre.
	**
	** Both are scaled by --btc-open, so the expansion rides the same single
	** transition as the slide rather than snapping at the end of it.
	*/

	.btc-fullwidth .tc-story-river {
		inline-size: auto;
		translate: none;
	}

	.btc-fullwidth.btc-layout-fluid-fixed .tc-story-river {
		margin-inline: var(--btc-story-left) calc(var(--btc-open) * var(--btc-sidebar-w));
	}

	.btc-fullwidth.btc-layout-fixed-fluid .tc-story-river {
		margin-inline: var(--btc-story-left)
			calc(var(--btc-open) * max(0px, 100vw - var(--btc-story-right)));
	}

	/* Zoomin storyview sizes its frames against the river, not the viewport.
	   The position/display pair lives outside this media query — it is what
	   makes the view overlay rather than stack, at every width. */
	.tc-page-view-zoomin .tc-tiddler-frame {
		inline-size: calc(100% - var(--btc-gutter));
	}

	.tc-story-river.tc-static-story-river {
		margin-inline-end: 0;
		translate: none;
	}

	/* ======================================================================
	** Sidebar on the inline START
	**
	** Everything above is written with logical properties, so putting the
	** sidebar on the other side is a matter of swapping the two ends rather
	** than rewriting the layout. Three things have to move together:
	**
	**   1. the panel's own inset, so it is anchored to the other edge;
	**   2. the river's margins, which reserve the space it occupies;
	**   3. --btc-dir, because `translate` percentages are PHYSICAL and the
	**      panel now has to leave toward the inline start. Flipping the sign
	**      keeps that in step with the story river's own glide, which reads
	**      the same variable - if only one of them flipped, the two would
	**      slide apart instead of together.
	**
	** The flip is applied on top of whatever direction the document is in, so
	** it composes with RTL rather than fighting it: in an RTL wiki with the
	** sidebar on the start side the two negations cancel and --btc-dir is +1
	** again, which is correct.
	** ====================================================================== */

	.btc-layout-fluid-fixed.btc-sidebar-start .tc-sidebar-scrollable {
		inset-inline: 0 auto;
	}

	.btc-layout-fluid-fixed.btc-sidebar-start .tc-story-river {
		margin-inline: calc(var(--btc-open) * var(--btc-sidebar-w)) var(--btc-story-left);
	}

	/*
	** The fluid sidebar keeps the width it would have had on the other edge -
	** everything past --btc-story-right - and the river starts where it ends.
	** Stating the width explicitly rather than pinning both insets is what
	** makes it the mirror: `inset-inline: 0 var(--btc-story-right)` would leave
	** a panel the width of the RIVER, not of the sidebar.
	*/
	.btc-layout-fixed-fluid.btc-sidebar-start .tc-sidebar-scrollable {
		inset-inline: 0 auto;
		inline-size: max(0px, calc(100vw - var(--btc-story-right)));
	}

	.btc-layout-fixed-fluid.btc-sidebar-start .tc-story-river {
		--btc-river-start: max(0px, calc(100vw - var(--btc-story-right)));
	}

	.btc-fullwidth.btc-layout-fluid-fixed.btc-sidebar-start .tc-story-river {
		margin-inline: calc(var(--btc-open) * var(--btc-sidebar-w)) var(--btc-story-left);
	}

	.btc-fullwidth.btc-layout-fixed-fluid.btc-sidebar-start .tc-story-river {
		margin-inline: calc(var(--btc-open) * max(0px, 100vw - var(--btc-story-right)))
			var(--btc-story-left);
	}
}

/* ==========================================================================
** Mobile — below the sidebar breakpoint
**
** The sidebar returns to normal document flow above the story river, which is
** TiddlyWiki's own mobile convention. It is deliberately NOT an overlay
** drawer: $:/state/sidebar defaults to OPEN, and that default is correct for
** a desktop column but would mean a drawer covering the whole page on first
** load on a phone. State is global, so it cannot mean "open" on desktop and
** "closed" on mobile.
**
** The collapse still slides. `grid-template-rows: 1fr -> 0fr` is animatable —
** it is the modern replacement for animating height to auto, and it is what
** the core reveal was doing in JavaScript. Same duration, same easing, same
** state class, so the behaviour stays continuous across the breakpoint.
** ========================================================================== */

@media (max-width: {{{ [{$:/theme}addsuffix[/metrics/sidebarbreakpoint]get[text]removesuffix[px]subtract[1]addsuffix[px]] ~[{$:/theme}addsuffix[/metrics/sidebarbreakpoint]get[text]] }}}) {

	.tc-story-river {
		position: relative;
		inline-size: auto;
		margin-inline: 0;
		padding: calc(var(--btc-gutter) * 0.5);
		translate: none;
	}

	.tc-sidebar-scrollable {
		position: static;
		inline-size: auto;
		display: grid;
		grid-template-rows: 1fr;
		transition:
			grid-template-rows var(--btc-dur) var(--btc-ease),
			visibility 0s linear var(--btc-vis-delay);
		translate: none;
		will-change: auto;
		border-block-end: 1px solid var(--btc-rule);

		/* The scrollable widget writes overflow-x/overflow-y as INLINE styles
		   on this node, so plain declarations lose to them. In flow the panel
		   must not be its own scroll container. */
		overflow: visible !important;
	}

	.btc-sidebar-closed .tc-sidebar-scrollable {
		grid-template-rows: 0fr;
		border-block-end-color: transparent;
	}

	/* The grid child does the clipping. min-block-size:0 is what lets a grid
	   track actually reach zero. */
	.tc-sidebar-scrollable > * {
		min-block-size: 0;
		overflow: hidden;
	}
}

/* ==========================================================================
** Full-width option — the tiddlers
**
** Deliberately OUTSIDE the media queries: once the option is on, tiddlers
** should fill the river at every width, not just on desktop.
**
** Placed after the desktop block on purpose. `.btc-layout-fluid-fixed
** .tc-tiddler-frame` and `.btc-fullwidth .tc-tiddler-frame` have identical
** specificity (0,2,0), and a media query adds none — so source order is what
** decides, and this has to come second to lift the cap.
**
** Note this also lifts the 68ch measure on the body. That is the honest
** meaning of "full width", but it is a real typographic trade: at very wide
** viewports the line length goes past comfortable reading. The option
** defaults to off for that reason.
** ========================================================================== */

.btc-fullwidth .tc-tiddler-frame {
	inline-size: 100%;
	max-inline-size: none;
	margin-inline: 0;
}

.btc-fullwidth .tc-tiddler-body {
	max-inline-size: none;
}

/* ==========================================================================
** Cost control
**
** In fluid-fixed the river relayouts each frame of the transition. Letting the
** browser skip rendering for tiddlers that are scrolled out of view keeps that
** bounded on long story rivers.
**
** :has() carves out the exceptions — a tiddler holding an open popup or an
** active editor must stay fully rendered, because containment would clip the
** dropdown and disturb the popup positioning in
** core/modules/utils/dom/popup.js.
** ========================================================================== */

.tc-story-river .tc-tiddler-frame {
	content-visibility: auto;
	contain-intrinsic-size: auto 480px;
}

.tc-story-river .tc-tiddler-frame:has(.tc-drop-down),
.tc-story-river .tc-tiddler-frame:has(.tc-block-dropdown),
.tc-story-river .tc-tiddler-frame:has(.tc-popup),
.tc-story-river .tc-tiddler-frame:has(.tc-tiddler-editor),
.tc-story-river .tc-tiddler-frame:has(:focus-within) {
	content-visibility: visible;
	contain-intrinsic-size: none;
}

/* ==========================================================================
** Reduced motion
**
** The slide collapses to an instant change. Note this keeps the layout
** CORRECT — it only removes the interpolation — because every rule above is
** written against --btc-open rather than against a swapped stylesheet.
** ========================================================================== */

@media (prefers-reduced-motion: reduce) {

	.tc-page-container,
	.tc-page-container-inner::after {
		transition-duration: 1ms;
	}

	.tc-sidebar-scrollable,
	.tc-story-river {
		will-change: auto;
	}
}

/* ==========================================================================
** Print — chrome off, river unconstrained
** ========================================================================== */

@media print {

	.tc-sidebar-scrollable,
	.tc-topbar,
	.tc-page-controls,
	.tc-tiddler-controls {
		display: none !important;
	}

	.tc-story-river {
		position: static;
		inline-size: auto;
		margin: 0;
		padding: 0;
		translate: none;
	}

	.tc-story-river .tc-tiddler-frame {
		content-visibility: visible;
		break-inside: avoid;
		box-shadow: none;
		margin: 0 0 1.5em 0;
	}
}
