title: $:/themes/BurningTreeC/vanilla-paper/plugins/markdown
tags: [[$:/tags/Stylesheet]]
code-body: yes

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline html

<$list filter="[[$:/plugins/tiddlywiki/markdown]is[tiddler]]" variable="ignore">

/* ==========================================================================
** Markdown
**
** Markdown tiddlers are still tiddlers, so most of the theme already applies.
** Two things need attention: the footnote apparatus, which markdown adds and
** the core has no equivalent of, and one integration bug.
** ========================================================================== */

/*
** The integration bug.
**
** $:/plugins/tiddlywiki/markdown/styles sets
**
**     scroll-margin-top: [{$:/themes/tiddlywiki/vanilla/options/stickytitles}
**                         match[yes]then[120px]else[60px]]
**
** so that jumping to a footnote does not land it underneath a stuck title. It
** reads VANILLA's sticky-titles option. This theme has its own, and ships the
** vanilla tiddler only as a compatibility shim holding a fixed default - so
** turning sticky titles on in Theme Tweaks would leave the plugin still
** reserving 60px and every footnote jump would land under the title.
**
** Rewritten against the option this theme actually uses. The value is the
** measured menubar height plus the sticky title's own height, because that is
** what is genuinely covering the top of the viewport.
*/
.markdown a.footnote-ref:target,
.markdown .footnote-item:target {
	scroll-margin-top: calc(var(--btc-menubar-h, 0px) + {{{ [{$:/theme}addsuffix[/options/stickytitles]get[text]match[yes]then[4.5rem]else[1rem]] }}});
	background-color: color-mix(in oklch, var(--tpc-primary) 14%, transparent);
	border-radius: var(--btc-radius);
}

/* ---- Footnotes ----
** A footnote apparatus is the most editorial thing markdown brings, so it is
** treated as one: separated from the body by a rule, set smaller, and in the
** interface face so it reads as apparatus rather than as more prose. */

.markdown .footnotes {
	margin-block-start: var(--btc-space-xl);
	padding-block-start: var(--btc-space-md);
	border-block-start: 1px solid var(--btc-rule);
	font-family: var(--btc-font-ui);
	font-size: 0.875rem;
	line-height: 1.55;
	color: var(--btc-ink-soft);
}

.markdown ol.footnotes-list {
	padding-inline-start: var(--btc-space-lg);
}

.markdown .footnote-item {
	margin-block: var(--btc-space-2xs);
}

.markdown .footnote-item p {
	margin-block: var(--btc-space-2xs);
}

/* The reference marker. Superscript numerals set in the interface face, with
   the link underline suppressed - an underline on a raised numeral reads as a
   smudge more than as a link. */
.markdown a.footnote-ref {
	font-family: var(--btc-font-ui);
	font-size: 0.7em;
	font-variant-numeric: tabular-nums;
	color: var(--tpc-tiddler-link-foreground);
	text-decoration: none;
	vertical-align: super;
	padding-inline: 1px;
}

.markdown a.footnote-ref:hover {
	text-decoration: underline;
}

.markdown a.footnote-backref {
	color: var(--tpc-tiddler-link-foreground);
	font-size: 0.8em;
	text-decoration: none;
	margin-inline-start: var(--btc-space-2xs);
}

/* ---- Everything else ---- */

/* The plugin's rule is a plain muted-foreground line. The theme has a rule
   colour, and markdown horizontal rules should be the same one the rest of the
   wiki uses. */
.markdown hr {
	margin-block: var(--btc-space-lg);
	border: 0;
	border-block-start: 1px solid var(--btc-rule);
}

/* `mark` is a highlighter on paper, so it gets the accent wash rather than the
   browser's default yellow. */
.markdown mark {
	padding: 1px 3px;
	border-radius: 2px;
	background-color: color-mix(in oklch, var(--tpc-primary) 18%, transparent);
	color: inherit;
}

</$list>
