title: $:/themes/BurningTreeC/vanilla-paper/plugins/menubar
tags: [[$:/tags/Stylesheet]]
code-body: yes

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline html

<$list filter="[[$:/plugins/tiddlywiki/menubar]is[tiddler]]" variable="ignore">

/* ==========================================================================
** Menu bar
**
** The theme already knows about this plugin from the other direction: a
** $:/tags/DimensionTracker entry measures the bar and the layout offsets the
** story river and the sticky titles by the measured height rather than by a
** guess. This sheet is only about how the bar LOOKS.
**
** This sheet is deliberately small. The bar gets the theme's typeface and a
** flat edge instead of the plugin's fixed `box-shadow 1px 1px 5px
** rgba(0,0,0,0.3)`, which is a black blur that reads as a bruise on cream
** paper and as nothing at all on a dark palette. Everything about how the bar
** BEHAVES stays with the plugin - see the note further down.
**
** Note the colour mechanism. Everywhere else this theme uses --tpc-* custom
** properties, but those are generated by $:/core/stylesheets/custom-properties
** from the index names in $:/palettes/Vanilla ONLY - and `menubar-background`
** is not one of them, so --tpc-menubar-background does not exist and
** var() on it resolves to nothing, leaving the bar transparent. Palette
** entries a PLUGIN introduces have to go through `colour`, which resolves
** through the active palette and then through the plugin's own
** $:/config/DefaultColourMappings.
**
** What is NOT overridden: the plugin's `margin-top` on .tc-sidebar-scrollable
** below the sidebar breakpoint. That is the plugin clearing its own bar for a
** sidebar that is in normal flow, and it correctly grows to
** calc(itemCount * 2em) while the hamburger menu is open - state this theme
** has no way to see. It is right, and it is left alone.
** ========================================================================== */

/*
** Even padding on both edges.
**
** The plugin uses `padding: 0 0 0 42px`, which reserves room for the hamburger
** - but the hamburger is `display: none` above the breakpoint, so at wide
** widths that is 42px of nothing before the first item, and the trailing item
** sits hard against the other edge with no padding at all. Paper puts the
** first item where the eye expects it and gives the last one the same margin.
**
** Logical, not physical: the plugin's `padding-left` would keep the indent on
** the left in an RTL wiki, where the bar reads the other way.
*/
nav.tc-menubar ul.tc-menubar-list {
	padding-inline: var(--btc-space-xs);
	background: <<colour menubar-background>>;
	box-shadow: none;
	border-block-end: 1px solid var(--btc-rule);
	font-family: var(--btc-font-ui);
	backdrop-filter: saturate(1.4) blur(6px);
}

/*
** THE PLUGIN'S OWN INTERACTION DESIGN IS LEFT ALONE.
**
** It inverts: on hover and when selected, the button's background becomes
** menubar-foreground and its text and fill become menubar-background. That is
** a deliberate, legible treatment for a bar that is usually a solid dark
** strip, and it is the plugin's to make.
**
** An earlier version of this sheet replaced it with an accent wash and a
** growing underline, and set `color` and `fill` unconditionally besides -
** which not only substituted a different design but broke the inversion,
** because the unconditional fill won over the plugin's hover fill and left the
** glyph the same colour as the background it had just moved onto.
**
** So the only thing taken here is the typeface. Hover, selected and the icon
** colours all stay with the plugin.
*/
nav.tc-menubar li.tc-menubar-item > a,
nav.tc-menubar li.tc-menubar-item > button {
	font-family: var(--btc-font-ui);
	font-size: 0.875rem;
}

/*
** A stray sidebar toggle in the bar's trailing slot is hidden here.
**
** With the sidebar on the leading edge the theme renders its own toggle as the
** first item in the bar, and overrides $:/core/ui/TopBar/menu so the trailing
** one is not emitted. A wiki that has ever saved its own copy of that tiddler
** holds a REAL tiddler, which beats a theme's shadow, and then both appear.
**
** base.tid hides any toggle without the .btc-sidebar-toggle marker, but that rule is
** (0,2,0) and the plugin's `nav.tc-menubar li.tc-menubar-item > button` is
** (0,3,3) with `display: inline-block` - so inside the bar it loses. This
** selector is (0,5,3) and is scoped to the bar, which is the only place that
** conflict arises; the standalone topbar has no competing display rule and the
** base.tid rule is enough there.
*/
.btc-sidebar-start nav.tc-menubar li.tc-menubar-item > :is(a, button):is(.tc-hide-sidebar-btn, .tc-show-sidebar-btn):not(.btc-sidebar-toggle) {
	display: none;
}

/*
** No transition on menubar buttons.
**
** The plugin's hover is an instant inversion, and most of its buttons carry no
** classes so they get one. The sidebar toggle is a .tc-btn-invisible, though,
** and this theme gives that class a 120ms background fade - so the one button
** eased into the inversion while every other snapped. Matching the bar means
** not animating here.
**
** (This is also what made the toggle look unstyled under measurement:
** getComputedStyle immediately after a state change reports the transition's
** START value, so the toggle read as transparent while its neighbours read as
** inverted. The cascade was correct throughout; only the reading was wrong.)
*/
nav.tc-menubar li.tc-menubar-item > a,
nav.tc-menubar li.tc-menubar-item > button {
	transition: none;
}

/* The plugin ships no focus style, which leaves a keyboard user with whatever
   the browser does over a coloured bar - often nothing. */
nav.tc-menubar li.tc-menubar-item > a:focus-visible,
nav.tc-menubar li.tc-menubar-item > button:focus-visible {
	outline: 2px solid <<colour menubar-foreground>>;
	outline-offset: -2px;
}

/* ---- Dropdowns ----
** These hang off the bar, so they are sheets of paper rather than menus: the
** theme's own card treatment, and the bar's hairline continued along the top
** edge so the panel reads as attached to the tab that opened it. */

nav.tc-menubar .tc-block-dropdown,
nav.tc-menubar .tc-drop-down {
	background: var(--tpc-dropdown-background);
	border: 1px solid var(--vp-paper-edge);
	border-start-start-radius: 0;
	border-start-end-radius: 0;
	border-end-start-radius: var(--btc-radius);
	border-end-end-radius: var(--btc-radius);
	box-shadow: 0 1px 2px var(--btc-shadow-soft), 0 10px 28px -12px var(--btc-shadow);
	font-family: var(--btc-font-ui);
}

nav.tc-menubar .tc-drop-down a {
	color: var(--tpc-tiddler-link-foreground);
}

nav.tc-menubar .tc-drop-down ol {
	padding-inline-start: var(--btc-space-lg);
}

nav.tc-menubar .tc-drop-down .tc-table-of-contents button,
nav.tc-menubar .tc-drop-down .tc-menubar-dropdown-sidebar button {
	font-family: var(--btc-font-ui);
	color: var(--tpc-foreground);
}

nav.tc-menubar .tc-more-sidebar > .tc-tab-set > .tc-tab-buttons > button {
	font-family: var(--btc-font-ui);
	font-size: 0.8125rem;
}

</$list>
