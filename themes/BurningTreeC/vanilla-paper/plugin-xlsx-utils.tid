/* ==========================================================================
** XLSX utils
**
** The import-spec editor is a set of nested levels - selector, editor,
** workbook, sheet, row, field - and the plugin tells them apart with six
** hardcoded pastel fills (#bac0f1, #bae3f1, #baf1db, #f1ebba, #f1baba,
** #e0d4fb) plus a matching border for each. Six literal colours, none of them
** related to any palette, and all of them near-white, so on a dark palette the
** whole editor is a stack of bright pastel blocks and the text on them is
** whatever the palette's foreground happens to be - light text on pale pink.
**
** The nesting is real information and should stay visible. Paper carries it
** with DEPTH rather than hue: each level steps a little further from the page
** colour, so the hierarchy reads as boxes nested inside boxes, in one palette,
** on paper of any darkness. The border on each level does the same.
** ========================================================================== */

.tc-import-spec-selector,
.tc-import-spec-editor,
.tc-import-spec-workbook,
.tc-import-spec-sheet,
.tc-import-spec-row,
.tc-import-spec-field {
	border-radius: var(--vp-radius);
	font-family: var(--vp-font-ui);
}

.tc-import-spec-selector {
	background-color: color-mix(in oklch, var(--tpc-foreground) 4%, var(--tpc-page-background));
	border: 1px solid color-mix(in oklch, var(--tpc-foreground) 14%, var(--tpc-page-background));
}

.tc-import-spec-editor {
	background-color: color-mix(in oklch, var(--tpc-foreground) 7%, var(--tpc-page-background));
	border: 1px solid color-mix(in oklch, var(--tpc-foreground) 18%, var(--tpc-page-background));
}

.tc-import-spec-workbook {
	background-color: color-mix(in oklch, var(--tpc-foreground) 10%, var(--tpc-page-background));
	border: 1px solid color-mix(in oklch, var(--tpc-foreground) 22%, var(--tpc-page-background));
}

.tc-import-spec-sheet {
	background-color: color-mix(in oklch, var(--tpc-foreground) 13%, var(--tpc-page-background));
	border: 1px solid color-mix(in oklch, var(--tpc-foreground) 26%, var(--tpc-page-background));
}

.tc-import-spec-row {
	background-color: color-mix(in oklch, var(--tpc-foreground) 16%, var(--tpc-page-background));
	border: 1px solid color-mix(in oklch, var(--tpc-foreground) 30%, var(--tpc-page-background));
}

.tc-import-spec-field {
	background-color: color-mix(in oklch, var(--tpc-foreground) 19%, var(--tpc-page-background));
	border: 1px solid color-mix(in oklch, var(--tpc-foreground) 34%, var(--tpc-page-background));
}

/* The control strips at each level. These are lists of buttons the plugin lays
   out inline; they read better as a toolbar with a hairline above them. */
.tc-import-spec-editor-controls,
.tc-import-spec-workbook-controls,
.tc-import-spec-sheet-controls,
.tc-import-spec-row-controls {
	font-family: var(--vp-font-ui);
	font-size: 0.8125rem;
}

.tc-import-spec-editor-controls li:not(:last-child),
.tc-import-spec-workbook-controls li:not(:last-child),
.tc-import-spec-sheet-controls li:not(:last-child),
.tc-import-spec-row-controls li:not(:last-child) {
	border-inline-end: 1px solid var(--vp-rule-faint);
}

/* The spec editor is a deeply nested set of fixed-ish panels. On a narrow
   screen the innermost level has almost no room left, so the whole thing is
   allowed to scroll horizontally inside its own wrapper rather than pushing
   the page sideways. */
.tc-import-spec-editor-wrapper,
.tc-import-spec-workbook-wrapper,
.tc-import-spec-sheet-wrapper,
.tc-import-spec-row-wrapper,
.tc-import-spec-field-wrapper {
	max-inline-size: 100%;
	overflow-x: auto;
	scrollbar-width: thin;
}

</$list>
