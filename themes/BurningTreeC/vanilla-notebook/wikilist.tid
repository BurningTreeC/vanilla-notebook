code-body: yes

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/* Hallmark · theme: Notebook · surface: TiddlyDesktop wiki list
 *
 * ============================================================================
 * NOTEBOOK — TIDDLYDESKTOP WIKI LIST
 * ============================================================================
 *
 * Styling for TiddlyDesktop's wiki list, shared by the desktop (nw.js) app and
 * the Android app — both render the same `td-` prefixed markup from
 * plugins/tiddlydesktop/WikiListRow.tid, and Android layers a topbar, a
 * slide-in sidebar and a share sheet on top of it.
 *
 * Division of labour
 * ------------------
 * TiddlyDesktop already ships the STRUCTURE — $:/TiddlyDesktop/styles/wikilist
 * and friends handle the flex layout, the thumbnail grid, the plugin dialog and
 * the drag behaviour, and none of that is this theme's business. What it reads
 * from the palette is colour, and most of the work here is therefore done by
 * NotebookDay / NotebookNight rather than by CSS.
 *
 * This file adds only what a palette cannot express: the reading face on
 * titles, a monospace face on paths, and the sheet-on-a-desk treatment that
 * makes a wiki row look like the tiddlers in the story river.
 *
 * Why the wiki row is a sheet
 * ---------------------------
 * The whole theme is "paper on a desk". A wiki row is exactly that shape — a
 * discrete object on a background — so it takes the same border, radius and
 * shadow as .tc-tiddler-frame. TiddlyDesktop already reserves a 4px inline-start
 * border that is transparent at rest and coloured on hover; that is the margin
 * rule, and the palette points it at the same red.
 *
 * Harmless when TiddlyDesktop is absent: none of these selectors match in an
 * ordinary wiki.
 * ============================================================================
 */

/* ==========================================================================
** The list and its sheets
** ========================================================================== */

.td-wikilist {
	background-color: var(--tpc-wikilist-background);
}

.td-wikilist .td-wikilist-item {
	background-color: var(--tpc-wikilist-item);
	border-radius: var(--nb-radius);
	border-block: 1px solid var(--nb-paper-edge);
	border-inline-end: 1px solid var(--nb-paper-edge);
	box-shadow: 0 1px 2px var(--nb-shadow-soft), 0 6px 18px -10px var(--nb-shadow);
	transition:
		box-shadow 180ms var(--nb-ease-out),
		border-inline-start-color 180ms var(--nb-ease-out);
}

.td-wikilist .td-wikilist-item:hover {
	box-shadow: 0 1px 2px var(--nb-shadow-soft), 0 10px 28px -12px var(--nb-shadow);
}

/* ==========================================================================
** Type
**
** A wiki's title is a title — it takes the reading face, like a tiddler title.
** Its path is not prose: monospace makes a long file path scannable and stops
** it being mistaken for a description.
** ========================================================================== */

.td-wikilist .td-wiki-title {
	font-family: var(--nb-font-body);
	font-size: 1.125rem;
	font-style: normal;
	font-weight: 600;
	line-height: 1.25;
	color: var(--tpc-wikilist-title);
	overflow-wrap: anywhere;
}

.td-wikilist .td-wiki-subtitle {
	font-family: var(--nb-font-ui);
	font-size: 0.8125rem;
	color: var(--tpc-wikilist-url);
}

.td-wikilist .td-wiki-url {
	font-family: var(--nb-font-code);
	font-size: 0.75rem;
	color: var(--tpc-wikilist-url);
	overflow-wrap: anywhere;
}

.td-wikilist .td-wikilist-info {
	color: var(--tpc-wikilist-info);
}

/* ==========================================================================
** Buttons
**
** Matched to this theme's own button voice: hairline radius, a real focus
** ring, and a 1px press. Colour stays with the palette, because TiddlyDesktop
** assigns meaning to each button through the wikilist-button-* keys.
**
** Those keys carry a constraint worth recording: wikilist-button-open is used
** BOTH as a fill (with wikilist-button-foreground on top, for Apply and the
** installed-version tag) and as a text/border colour on the page background
** (for the outlined Reinstall button in the plugin dialog). It therefore has to
** be a mid-tone that reads either way, which is why the palettes do not push it
** to a pale tint in light mode or a deep shade in dark mode.
** ========================================================================== */

button.td-button,
a.td-button {
	border-radius: var(--nb-radius);
	font-family: var(--nb-font-ui);
	transition:
		background-color 120ms var(--nb-ease-out),
		translate 80ms var(--nb-ease-out);
}

button.td-button:active,
a.td-button:active {
	translate: 0 1px;
}

button.td-button:focus-visible,
a.td-button:focus-visible {
	outline: 2px solid var(--nb-focus);
	outline-offset: 2px;
}

.td-wikilist .td-wiki-toolbar {
	font-family: var(--nb-font-ui);
}

/* ==========================================================================
** Advanced panel and plugin dialog
**
** Both are inset surfaces rather than sheets, so they take the theme's info
** panel treatment instead of the paper one.
** ========================================================================== */

.td-wikilist .td-wiki-advanced {
	background-color: var(--tpc-tiddler-info-background);
	border: 1px solid var(--tpc-tiddler-info-border);
	border-radius: var(--nb-radius);
}

.td-wiki-advanced-heading {
	font-family: var(--nb-font-ui);
	color: var(--nb-ink-faint);
	border-block-end: 1px solid var(--nb-rule);
}

.td-wiki-advanced-field input,
.td-plugin-search {
	font-family: var(--nb-font-ui);
	border-radius: var(--nb-radius);
}

.td-wiki-advanced-field input:focus-visible,
.td-plugin-search:focus-visible {
	outline: 2px solid var(--nb-focus);
	outline-offset: 1px;
}

.td-plugin-dialog {
	border-radius: var(--nb-radius-lg);
	box-shadow: 0 24px 64px -24px var(--nb-shadow), 0 2px 8px var(--nb-shadow-soft);
}

.td-plugin-heading {
	font-family: var(--nb-font-body);
	font-weight: 600;
}

.td-plugin-title {
	font-family: var(--nb-font-code);
}

.td-plugin-tab {
	font-family: var(--nb-font-ui);
	border-start-start-radius: var(--nb-radius);
	border-start-end-radius: var(--nb-radius);
}

/* ==========================================================================
** Android
**
** The phone build adds a sticky topbar, a slide-in sidebar and a share sheet.
** Its own stylesheet deliberately uses palette-agnostic translucent fills for
** the sidebar items — `rgba(128,128,128,0.16) !important` — so that they stay
** legible under any palette. That is a reasonable defensive choice and this
** theme does not fight it; only the surfaces around them are re-tinted.
** ========================================================================== */

.td-topbar {
	background-color: var(--tpc-wikilist-toolbar-background);
	color: var(--tpc-wikilist-toolbar-foreground);
	border-block-end: 1px solid var(--nb-rule);
	box-shadow: none;
}

.td-topbar-title {
	font-family: var(--nb-font-body);
	font-weight: 600;
}

.td-sidebar {
	background-color: var(--tpc-background);
	color: var(--tpc-foreground);
	box-shadow: calc(var(--nb-dir) * 12px) 0 32px -8px var(--nb-shadow);
}

.td-sidebar-head {
	border-block-end: 1px solid var(--nb-rule);
}

.td-share-panel {
	background-color: var(--tpc-modal-background);
	color: var(--tpc-foreground);
	border: 1px solid var(--tpc-modal-border);
	border-radius: var(--nb-radius-lg);
	box-shadow: 0 24px 64px -24px var(--nb-shadow);
}

.td-share-heading {
	font-family: var(--nb-font-body);
	font-weight: 600;
}

/* On a phone the list is the whole page, so the sheets lose their side borders
   and run edge to edge — the same call the theme makes for tiddler frames on a
   narrow screen. */
@media (max-width: 480px) {

	.td-wikilist {
		padding: 0.5em;
	}

	.td-wikilist .td-wikilist-item {
		border-radius: 0;
		border-inline-end: none;
	}
}

/* ==========================================================================
** Reduced motion
** ========================================================================== */

@media (prefers-reduced-motion: reduce) {

	.td-wikilist .td-wikilist-item,
	button.td-button,
	a.td-button {
		transition-duration: 1ms;
	}
}
