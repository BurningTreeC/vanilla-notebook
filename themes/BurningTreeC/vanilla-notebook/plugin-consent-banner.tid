<$list filter="[[$:/plugins/tiddlywiki/consent-banner]is[tiddler]]" variable="ignore">

/* ==========================================================================
** Consent banner
**
** A consent banner has one job and it is not decoration: the reader has to be
** able to find the buttons and tell them apart. So this stays close to the
** plugin's structure and spends its effort on the parts that affect whether
** the thing is usable - real focus rings, buttons that are obviously buttons,
** and a panel that scrolls on a short screen instead of running off it.
**
** All consent-banner-* entries are the plugin's own palette additions, absent
** from $:/palettes/Vanilla, so they go through `colour` - no --tpc-* is
** generated for them.
** ========================================================================== */

.tc-consent-backdrop {
	background: <<colour consent-banner-backdrop-background>>;
	backdrop-filter: blur(2px);
}

.tc-consent-banner-left {
	max-inline-size: 500px;
	/* The plugin pins this panel to all four edges and lets it scroll. On a
	   short window the buttons are the first thing to go off the bottom, so
	   the scroll container gets a visible gutter rather than a hidden one. */
	scrollbar-gutter: stable;
}

.tc-consent-banner {
	padding: var(--nb-space-lg);
	background: <<colour consent-banner-background>>;
	color: <<colour consent-banner-foreground>>;
	box-shadow: 0 0 40px -8px var(--nb-shadow);
	font-family: var(--nb-font-ui);
	line-height: 1.55;
}

.tc-consent-banner a.tc-tiddlylink-external,
.tc-consent-banner a.tc-tiddlylink-external:visited {
	color: <<colour consent-banner-link-foreground>>;
	background-color: inherit;
	text-decoration: underline;
	text-underline-offset: 0.15em;
}

.tc-consent-banner hr {
	margin-block: var(--nb-space-lg);
	block-size: 1px;
	border: 0;
	background: <<colour consent-banner-hr-background>>;
}

/* ---- Buttons ----
** The plugin gives these a border, a fill and bold text, then on hover sets
** `opacity: .6` - which fades the TEXT as well as the background, so the
** button you are pointing at becomes the hardest one to read. Replaced with a
** change of fill and border, which is what hover is supposed to signal. */

.tc-consent-button {
	margin-block-start: var(--nb-space-md);
	padding: 0.75em 1.5em;
	border: 1px solid <<colour consent-banner-button-border>>;
	border-radius: var(--nb-radius);
	color: <<colour consent-banner-button-foreground>>;
	background: <<colour consent-banner-button-background>>;
	font-family: var(--nb-font-ui);
	font-weight: 600;
	cursor: pointer;
	transition: background-color 140ms var(--nb-ease-out), border-color 140ms var(--nb-ease-out);
}

.tc-consent-banner .tc-consent-button {
	margin-inline-end: var(--nb-space-md);
}

.tc-consent-button:hover {
	opacity: 1;
	color: <<colour consent-banner-button-hover-foreground>>;
	border-color: <<colour consent-banner-button-hover-border>>;
	background: <<colour consent-banner-button-hover-background>>;
}

/* A consent dialog is exactly the kind of thing people navigate by keyboard.
   The plugin ships no focus style at all, which leaves whatever the browser
   does - often nothing visible against a coloured button. */
.tc-consent-button:focus-visible {
	outline: 2px solid <<colour consent-banner-button-foreground>>;
	outline-offset: 2px;
}

.tc-consent-button-default {
	color: <<colour consent-banner-button-default-foreground>>;
	background: <<colour consent-banner-button-default-background>>;
}

/* ---- Blocked embeds ----
** The placeholder that stands in for content the reader has not consented to
** load. It should read as a deliberate gap on the page, not as a broken image,
** so it gets paper and a dashed edge - the same language the theme uses for
** "something goes here". */

.tc-blocked-embedded-content {
	display: inline-block;
	overflow: hidden;
	max-inline-size: 100%;
	color: var(--nb-ink-soft);
	background: var(--tpc-tiddler-editor-background);
	border: 1px dashed var(--nb-rule);
	border-radius: var(--nb-radius);
	box-shadow: none;
	font-family: var(--nb-font-ui);
	font-size: 0.875rem;
	text-align: center;
}

.tc-blocked-embedded-content-inner-inner hr {
	background: var(--nb-rule);
	block-size: 1px;
	inline-size: 80%;
	border: none;
}

</$list>
