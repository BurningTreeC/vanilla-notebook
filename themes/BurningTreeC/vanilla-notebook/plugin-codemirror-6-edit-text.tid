<$list filter="[[$:/plugins/tiddlywiki/codemirror-6-edit-text]is[tiddler]]" variable="ignore">

/* ==========================================================================
** CodeMirror 6 - simple edit-text fields
**
** This plugin puts CM6 behind the ordinary one-line inputs: the title field,
** the tag input, field values. Those are FORM CONTROLS, not editors, and the
** theme already has a look for them - so the job here is to make the CM6
** instance disappear into the input it replaced rather than to style it as an
** editor in miniature.
**
** Every selector below is prefixed `html body`, matching the plugin's own
** selectors exactly. That is not decoration: the plugin writes
** `html body .tc-editor-codemirror6-simple .cm-editor`, which is (0,1,4), and
** an ordinary two-class rule here would lose to it no matter what order the
** sheets are in. Matching the shape is what makes these overrides take.
** ========================================================================== */

html body .tc-editor-codemirror6-simple .cm-editor {
	background: var(--tpc-tiddler-editor-background);
	color: var(--tpc-foreground);
	font-family: var(--nb-font-ui);
	font-size: inherit;
	border-radius: var(--nb-radius);
}

/* The title field is set in the theme's display face at title size, and the
   CM6 instance standing in for it has to match or the title visibly changes
   shape the moment you click into it. */
html body .tc-tiddler-frame .tc-editor-codemirror6-simple .cm-editor {
	font-family: var(--nb-font-body);
}

html body .tc-tiddler-frame .tc-edit-tags .tc-editor-codemirror6-simple .cm-editor {
	font-family: var(--nb-font-ui);
	font-size: 0.875rem;
}

/* A single-line control gets the theme's focus ring, not CodeMirror's outline
   suppression - these are exactly the fields people tab through. */
html body .tc-editor-codemirror6-simple .cm-editor.cm-focused {
	outline: 2px solid var(--nb-focus);
	outline-offset: 1px;
}

html body .tc-editor-codemirror6-simple .cm-content,
html body .tc-editor-codemirror6-simple .cm-line {
	padding-inline: var(--nb-space-2xs);
	caret-color: var(--tpc-foreground);
}

html body .tc-editor-codemirror6-simple .cm-placeholder {
	color: var(--nb-ink-faint);
	font-style: normal;
}

html body .tc-editor-codemirror6-simple .cm-editor .cm-line ::selection,
html body .tc-editor-codemirror6-simple .cm-editor:not(.cm-focused) .cm-content ::selection {
	background: color-mix(in oklch, var(--tpc-primary) 26%, transparent);
}

/* No gutter on a one-line field. The plugin already suppresses most of it;
   this makes sure nothing shows through as a stripe down the input. */
html body .tc-editor-codemirror6-simple .cm-gutters {
	background: transparent;
	border: none;
}

html body .tc-editor-codemirror6-simple .cm-activeLineGutter {
	background: transparent;
}

/* Read-only fields say so by going quiet, rather than by the plugin's fixed
   rgba(0,0,0,0.15) which is invisible on a dark palette. */
html body .tc-editor-codemirror6-simple .cm-editor.cm-readonly {
	background: color-mix(in oklch, var(--tpc-foreground) 6%, var(--tpc-tiddler-editor-background));
	color: var(--nb-ink-soft);
}

</$list>
