<$list filter="[[$:/plugins/tiddlywiki/katex]is[tiddler]]" variable="ignore">

/* ==========================================================================
** KaTeX
**
** KaTeX brings its own fonts and its own metrics, and it should - the whole
** point of it is that the mathematics is set properly. Nothing here touches
** the maths itself.
**
** What it does not know about is the page around it. KaTeX sizes relative to
** its container and inherits colour, so it lands slightly small against a
** serif body face and, in display mode, sits in the flow with no room to
** breathe. Those are the two things worth correcting, plus giving a long
** equation somewhere to go on a narrow screen.
** ========================================================================== */

/*
** KaTeX's own metrics assume a 16px context. The body here is set in a serif
** at a larger size, so inline maths comes out visibly smaller than the words
** on either side of it. 1.06em is the nudge that makes an inline formula sit
** on the same optical line as the sentence containing it.
*/
.tc-tiddler-body .katex {
	font-size: 1.06em;
	color: var(--tpc-foreground);
}

/*
** Display equations are their own block, so they get the theme's block rhythm
** and a place to scroll. Without the scroll container a wide matrix pushes the
** whole story river sideways - the page itself starts scrolling horizontally,
** which is the one thing the layout must never do.
*/
.tc-tiddler-body .katex-display {
	margin-block: var(--nb-space-lg);
	padding-block: var(--nb-space-2xs);
	overflow-x: auto;
	overflow-y: hidden;
	scrollbar-width: thin;
}

/* Numbered equations: the tag is chrome, not mathematics, so it takes the
   interface face and a muted ink to stay out of the way of the formula. */
.tc-tiddler-body .katex-display > .katex > .katex-html > .tag {
	font-family: var(--nb-font-ui);
	font-size: 0.8125rem;
	color: var(--nb-ink-faint);
}

/* KaTeX draws rules - fraction bars, radicals, overlines - as bordered or
   filled boxes that inherit currentColor. Under a palette whose foreground is
   not near-black they can end up heavier than the glyphs they belong to. */
.katex .frac-line,
.katex .overline .overline-line,
.katex .underline .underline-line,
.katex .hline,
.katex .hdashline,
.katex .rule {
	border-color: currentColor;
}

/* An error in a formula should read as an error in this theme's language, not
   as KaTeX's fixed red on a colour it chose for a white page. */
.katex .katex-error {
	color: var(--tpc-alert-highlight);
}

/* Selected maths keeps the page's selection colours instead of KaTeX's. */
.katex ::selection {
	background: color-mix(in oklch, var(--tpc-primary) 24%, transparent);
}

</$list>
